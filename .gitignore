#ignore system files
.DS_Store
Thumbs.db

#ignore php error
error_log

#ignore application folder, application folder must be another project
application/*
!application/cresenity

#ignore project folder
project/*
#ignore frontend folder
frontend/*
#ignore mobile folder
mobile/*

/config/
/config/*
!config/client_modules.php

#ignore data domain or org
/data/*
!/data/.gitkeep
#ignore
/index.php

#ignore git bak
/.git.bak

/access.log

#phpunit
.phpunit.result.cache

#ignore libs of CPDF
/modules/cresenity/vendor/lib/fonts/Helvetica.afm.php
/modules/cresenity/vendor/lib/fonts/Helvetica-Bold.afm.php
/modules/cresenity/vendor/lib/fonts/Helvetica-Oblique.afm.php
/modules/cresenity/vendor/lib/fonts/Helvetica-BoldOblique.afm.php

#ignore fonts generated by Dompdf at runtime
#the four rules above cover the deprecated modules/ layout only; Dompdf now
#lives in system/vendor and writes its cache, its parsed .afm.php, and any
#font installed through @font-face here. The installed ones are named after a
#32 character hash, which no shipped font is - hence the 32 wildcards.
/system/vendor/Dompdf/lib/fonts/dompdf_font_family_cache.php
/system/vendor/Dompdf/lib/fonts/*.afm.php
/system/vendor/Dompdf/lib/fonts/????????????????????????????????.ttf
/system/vendor/Dompdf/lib/fonts/????????????????????????????????.ufm

#ignore libs of HTMLPurifier
/system/vendor/HTMLPurifier/DefinitionCache/Serializer/CSS/
/system/vendor/HTMLPurifier/DefinitionCache/Serializer/HTML/
/system/vendor/HTMLPurifier/DefinitionCache/Serializer/URI/
/system/vendor/HTMLPurifier/DefinitionCache/Serializer/CSS/*
/system/vendor/HTMLPurifier/DefinitionCache/Serializer/HTML/*
/system/vendor/HTMLPurifier/DefinitionCache/Serializer/URI/*

#ignore folder logs
/application/logs
/logs/
*/logs/
/temp
/temp/*
/export/
/resources

/resource
/files
/certificate
/upload/*
/payment_log/
/compiled

#ignore netbeans ide config
/nbproject/
*/nbproject/*

#ignore aptana IDE
.project

#ignore the other files
.idea/*
*.iml
sftp-config*.json

# root composer.json is tracked (phpcf/cf.isCF() detects the framework root by
# its "name": "cresenity/cf") - only vendored libraries' own composer.json stays ignored
system/vendor/**/composer.json
.well-known
.well-known/*
__sublime_sftp_offset
.rnd

#SEO
robots.txt
botlog.log


# Elastic Beanstalk Files
.elasticbeanstalk/*
!.elasticbeanstalk/*.cfg.yml
!.elasticbeanstalk/*.global.yml


#ignore vscode
.vscode

#ignore claude code
# Sengaja terbalik: tidak ada isi .claude/ yang ikut repo kecuali yang disebut
# di bawah. Pola sebaliknya - "semua ikut kecuali X" - harus diperbarui setiap
# Claude Code menambah jenis berkas baru di sana, dan kalau terlewat berkasnya
# ter-commit tanpa peringatan apa pun.
#
# Harus /.claude/* (isinya), bukan /.claude/ (direktorinya): git tidak bisa
# membatalkan pengabaian sebuah berkas bila direktori induknya yang diabaikan,
# sehingga ketiga baris ! di bawah akan diam-diam tidak berfungsi.
#
# settings.json sengaja tidak dibuka: isinya hooks yang dieksekusi dan daftar
# izin yang menyebut host serta jalur internal.
/.claude/*
!/.claude/skills/
!/.claude/agents/
!/.claude/commands/

#ignore graphify
# Seluruh keluaran graphify hanya untuk lokal - tidak ikut repo.
# Semuanya dapat dibangun ulang dari kode, termasuk cadangan bertanggal
# (graphify-out/YYYY-MM-DD/) yang dibuat backup_if_protected() sebelum menimpa.
**/graphify-out/

.php_cs.cache
*.py

#phpunit
.phpunit.result.cache

.bin/*


# ignore all IIS files
web.config

# ignore phar archives
*.phar

# ignore composer.lock
composer.lock

#ignore cache of php-cs-fixer
.php-cs-fixer.cache

# Node Dependency directories
node_modules/
jspm_packages/

# Deployment file
deploy.blade.php
**/deploy.blade.php

#generated file
oauth-public.key
oauth-private.key

#escape local development
capp.code-workspace

# Catatan kerja lokal — tidak ikut repo
/docs
/reference

# CLAUDE.md sekarang disinkron dari devcloud (appCode "cf"), bukan git —
# lihat phpcf claude:sync. Sebelumnya berkas ini publik di repo CF; kalau
# ada checkout lama yang masih melacaknya, jalankan git rm --cached CLAUDE.md.
/CLAUDE.md

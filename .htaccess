Options -Indexes

# Turn on URL rewriting
RewriteEngine On

# Installation directory
RewriteBase /

RewriteCond %{HTTP_HOST} ^www\.(.*)$ [NC]
RewriteRule ^(.*)$ http://%1/$1 [R=301,L]

# Protect application and system files from being viewed
# RewriteCond %{REQUEST_URI} !^/?(wp)/
RewriteCond %{REQUEST_URI} !^/?(modules/.+?/media|system/media)/ [NC]

RewriteRule ^(modules|system|logs) - [F,L]
RewriteRule ^(wp)($|/) - [L]
RewriteCond %{REQUEST_URI} !^/?(wp)/

# Allow any files or directories that exist to be displayed directly
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d

# Rewrite all other URLs to index.php/URL
RewriteRule .* index.php/$0 [PT,L]


# Berkas yang tidak boleh disajikan langsung.
#
# Digabung menjadi sedikit aturan beralternasi, BUKAN satu aturan per berkas.
# Sebelumnya ada ~38 RewriteRule berurutan di sini dan LiteSpeed diam-diam
# berhenti memprosesnya setelah sekitar aturan ke-30: phpstan.neon, CLAUDE.md,
# dan TODO.md tetap tersaji 200 padahal aturannya ada. Tidak ada galat, hanya
# aturan yang tidak pernah berlaku — jadi jangan kembali ke pola satu-aturan-
# per-berkas, dan bila menambah sesuatu, sisipkan ke alternasi di bawah.
RewriteRule \.(log|sql|key|pem|neon|dist|cache)$ - [R=404,L]
RewriteRule (^|/)(\.env|env\.php)(\..+)?$ - [R=404,L]

# Kredensial: berkas service account Google berekstensi .json sehingga tidak
# tertangkap aturan ekstensi di atas, dan berkas kunci enkripsi aplikasi sama
# sekali tidak berekstensi (ssh, dbconnection, cloudaccount).
RewriteRule ^(.*/)?service-account-credentials\.json$ - [R=404,L]
RewriteRule ^application/[^/]+/default/data/(vendor|key)/ - [R=404,L]

# Dokumentasi dan catatan aplikasi, baik di akar app (`docs/`) maupun di bawah
# `default/data/docs/`. Halaman dokumentasi dilayani lewat rute `/docs/...`,
# jadi berkas sumbernya tidak perlu dapat diunduh langsung — tanpa aturan ini
# seluruh isinya terbaca siapa saja.
#
# Sengaja TIDAK memblokir `data/` secara menyeluruh: sebagian aplikasi memang
# menyajikan aset dari sana, mis. `MXPreset_Theme::baseUrl()` mengembalikan
# `application/maxpage/default/data/preset/` sebagai URL publik. Yang diblokir
# hanya direktori docs dan berkas markdown, yang tidak pernah menjadi aset.
RewriteRule ^application/[^/]+/(docs|default/data/docs)/ - [R=404,L]
RewriteRule ^application/[^/]+/default/data/.*\.md$ - [R=404,L]

# Berkas titik dan metadata editor/VCS
RewriteRule ^(.*/)?\.((claude|git(hub)?|vscode|idea)/|(DS_Store|git.*|editorconfig|htaccess.*|php_cs.*|stylelintrc|prettierrc|eslintrc|eslintignore|php-cs-fixer\.cache|phpunit\.result\.cache)$) - [R=404,L]

# Dokumen dan berkas proyek
RewriteRule ^(.*/)?(CLAUDE|TODO|BUG|README|CHANGELOG)\.md$ - [R=404,L]
RewriteRule ^(.*/)?(package\.json|package-lock\.json|composer\.json|composer\.lock|phpcs\.xml|phpstan\.neon|cf-manifest\.json|Thumbs\.db|_ide_helper\.php|problem\.txt)$ - [R=404,L]

# Berkas contoh, skrip, dan dump bawaan
RewriteRule ^(.*/)?(devsuite\.php|server\.php|index\.php\.sample)$ - [R=404,L]
RewriteRule ^(.*/)?default-capp(-chat|-oauth2|-tracker)?\.sql$ - [R=404,L]
RewriteRule ^cf$ - [R=404,L]
